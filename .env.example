PORT=3000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_TIMEOUT_MS=90000

# Shared AI: set an HTTPS gateway URL and its token on Render, not in browser code.
OLLAMA_API_KEY=
OLLAMA_STATUS_TIMEOUT_MS=5000
# Optional: Cloudflare Access service-token credentials for a named tunnel.
OLLAMA_CF_ACCESS_CLIENT_ID=
OLLAMA_CF_ACCESS_CLIENT_SECRET=
