{
  "name": "nmdwsm",
  "version": "1.0.0",
  "description": "電腦硬體推薦、市價查詢、二手估價與跑分教學平台",
  "main": "public/server.js",
  "scripts": {
    "start": "node public/server.js",
    "test": "node --test test/smoke.test.js",
    "test:unit": "node --test test/hardware.test.js test/services.test.js test/valuation.test.js test/computer-product.test.js test/market-classifier.test.js test/used-search.test.js",
    "model:train": "node train.js",
    "model:evaluate": "node scripts/evaluate-market-classifier.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "ai:setup": "node scripts/setup-ai-gateway.js",
    "ai:gateway": "node scripts/ai-gateway.js",
    "test:ai": "node --test test/ollama-remote.test.js"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "fasttext.js": "^1.1.4",
    "puppeteer": "^23.0.0",
    "puppeteer-extra": "^3.3.4",
    "puppeteer-extra-plugin-stealth": "^2.11.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "eslint": "^8.44.0",
    "prettier": "^3.0.0"
  }
}
